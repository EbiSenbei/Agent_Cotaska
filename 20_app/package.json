{
  "name": "cotaska",
  "version": "0.4.1",
  "description": "Cotaska - ローカルタスク管理システム",
  "main": "src/main/main.js",
  "scripts": {
    "check:runtime": "node scripts/verify-runtime.js",
    "predev": "npm run check:runtime",
    "prebuild": "npm run check:runtime",
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "start": "electron .",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:installer": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --publish never",
    "test": "vitest run --config vite.config.mjs",
    "test:watch": "vitest --config vite.config.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.0.12",
    "rcedit": "^5.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.cotaska.app",
    "productName": "Cotaska",
    "afterExtract": "scripts/afterExtract.cjs",
    "artifactName": "Cotaska-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**",
      "src/main/**",
      "package.json",
      "node_modules/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/app-config.yaml",
        "to": "app-config.yaml"
      },
      {
        "from": "setup/launcher/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@openai/codex-*/vendor/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "EbiSenbei",
        "repo": "cotaska-site",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "setup/launcher/icon.ico",
      "executableName": "Cotaska",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cotaska",
      "menuCategory": "Cotaska",
      "uninstallDisplayName": "Cotaska",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@openai/codex-sdk": "0.153.4",
    "adm-zip": "^0.5.17",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "markdown-it": "^14.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sql.js": "^1.14.1"
  }
}
